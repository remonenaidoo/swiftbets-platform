# Local development only. Copy to .env (make env does this); .env is git-ignored. Cloud values come from Kubernetes Secrets.
SWIFTBETS_ENV=dev
SWIFTBETS_TAG=local
MSSQL_SA_PASSWORD=Local-Dev-Sa-Pass-1
PLACEMENT_DB_PASSWORD=Local-Dev-Placement-1
WALLET_DB_PASSWORD=Local-Dev-Wallet-1
SETTLEMENT_DB_PASSWORD=Local-Dev-Settlement-1
PAYOUT_DB_PASSWORD=Local-Dev-Payout-1
IDENTITY_DB_PASSWORD=Local-Dev-Identity-1
COMPLIANCE_DB_PASSWORD=Local-Dev-Compliance-1
PAYMENTS_DB_PASSWORD=Local-Dev-Payments-1
POSTGRES_PASSWORD=local-dev-postgres
STEWARD_DB_PASSWORD=local-dev-steward
HISTORY_DB_PASSWORD=local-dev-history
CATALOG_DB_PASSWORD=local-dev-catalog
NOTIFICATIONS_DB_PASSWORD=local-dev-notifications
CONFIG_DB_PASSWORD=local-dev-config
GRAFANA_ADMIN_PASSWORD=local-dev-grafana
DEMO_PASSWORD=Local-Dev-Demo-1
PAYOUT_CLIENT_SECRET=local-dev-payout-client-secret
CASINO_DB_PASSWORD=Local-Dev-Casino-1
CASINO_CATALOG_DB_PASSWORD=local-dev-casino-catalog
RISK_DB_PASSWORD=local-dev-risk
CASINO_CLIENT_SECRET=local-dev-casino-client-secret
NOTIFICATIONS_CLIENT_SECRET=local-dev-notifications-client-secret
REPORTING_CLIENT_SECRET=local-dev-reporting-client-secret
STEWARD_ALERT_TOKEN=local-dev-steward-alert-token
WAREHOUSE_DB_PASSWORD=local-dev-warehouse
GRAFANA_READER_PASSWORD=local-dev-grafana-reader
# Each simulated provider signs its wallet calls with its own secret.
CASINO_SIM_SEAMLESS_SECRET=local-dev-sim-seamless-secret-0123456789abcdef
CASINO_SIM_TRANSFER_SECRET=local-dev-sim-transfer-secret-0123456789abcdef
# The origin browsers use; game pages load from it (the preview sets its public URL).
PUBLIC_ORIGIN=http://localhost:7100
PAYMENTS_CLIENT_SECRET=local-dev-payments-client-secret
PLACEMENT_CLIENT_SECRET=local-dev-placement-client-secret
CASHOUT_CLIENT_SECRET=local-dev-cashout-client-secret
HISTORY_CLIENT_SECRET=local-dev-history-client-secret
# Base64, 32+ bytes: signs cashout quotes.
CASHOUT_SIGNING_KEY=bG9jYWwtZGV2LWNhc2hvdXQtcXVvdGUtc2lnbmluZy1r
PAYMENTS_SIMULATOR_API_KEY=local-dev-simulator-key
PAYMENTS_WEBHOOK_SECRET=local-dev-simulator-webhook-secret
# simulator | paystack (needs PAYSTACK_TEST_SECRET_KEY, an sk_test_ key)
PAYMENTS_DEPOSIT_PROVIDER=simulator
PAYSTACK_TEST_SECRET_KEY=
# Local limits sized for the k6 load profile (everything arrives from one IP); production defaults are 10 / 120 / 600.
GATEWAY_LOGIN_PER_MINUTE=600
GATEWAY_PLACEMENTS_PER_USER_PER_MINUTE=20000
GATEWAY_REQUESTS_PER_IP_PER_MINUTE=200000
STEWARD_CLIENT_SECRET=local-dev-steward-client-secret
# replay (scripted, free) | anthropic (needs ANTHROPIC_API_KEY) | disabled
STEWARD_MODEL_PROVIDER=replay
ANTHROPIC_API_KEY=
STEWARD_EMBEDDINGS=ollama

# Optional second gateway port for a host reverse proxy (public preview).
GATEWAY_EDGE_BIND=127.0.0.1
GATEWAY_EDGE_PORT=7101

# Optional: sign every visitor in as this demo account (an open preview). Leave empty to show the sign-in form.
GATEWAY_DEMO_SIGN_IN_USER=
GATEWAY_DEMO_SIGN_IN_PUNTER=
GATEWAY_DEMO_SIGN_IN_PASSWORD=
